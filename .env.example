# Project Configuration
PROJECT_NAME="Zerdeli EdTech"
# development | production
ENV="development"

# Security
# REQUIRED. Generate a strong value (>= 32 random chars):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start in production with a missing/weak key.
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_USER=zerdeli_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=zerdeli_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://zerdeli_user:change_this_strong_password@localhost:5432/zerdeli_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Comma-separated list of browser origins allowed to call the API (no wildcard).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
